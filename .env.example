# Copy this file to .env.local for local development, or add these as
# Environment Variables in your Vercel project settings for production.
# Every variable below is OPTIONAL — the site is fully functional with none of them set.

# The canonical URL of the deployed site. Used for SEO metadata, the
# sitemap, and Open Graph tags. Defaults to the Vercel preview URL if unset.
NEXT_PUBLIC_SITE_URL=https://sahilpoojary-website.vercel.app

# Upgrades "Ask Sahil" from the free, local, grounded-retrieval engine to
# full natural-language answers via the Anthropic API. Without this key,
# Ask Sahil still works perfectly — it just answers using direct keyword
# matching against the verified profile data instead of an LLM.
# Get a key at https://console.anthropic.com/ — never commit this value.
ANTHROPIC_API_KEY=

# Optional: override the default model used for Ask Sahil once
# ANTHROPIC_API_KEY is set above.
ASK_SAHIL_MODEL=claude-sonnet-5
